{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark. Concept: Dead Channel -- a CRT tuned to nothing. Dark is the canonical mode (flat black); light is a derived 'printout' mode.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f2f2ec", "$description": "Derived printout mode: phosphor paper." },
      "foreground": { "$value": "#0a0a0a" },
      "border": { "$value": "#c9c9c1" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#0a0a0a" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#0a0a0a" },
      "primary": {
        "$value": "#006b78",
        "$description": "Signal cyan, darkened for contrast on paper."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#e4e4dc" },
      "secondaryForeground": { "$value": "#0a0a0a" },
      "muted": { "$value": "#e4e4dc" },
      "mutedForeground": { "$value": "#55554f" },
      "accent": { "$value": "#c4005f", "$description": "Glitch magenta, darkened for paper." },
      "accentForeground": { "$value": "#ffffff" },
      "destructive": { "$value": "#c41d1d" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#b5b5ad" },
      "ring": { "$value": "#006b78" },
      "chart1": { "$value": "#006b78" },
      "chart2": { "$value": "#c4005f" },
      "chart3": { "$value": "#8a7a00" },
      "chart4": { "$value": "#5a3fc0" },
      "chart5": { "$value": "#2f7a2f" },
      "sidebar": { "$value": "#e9e9e2" },
      "sidebarForeground": { "$value": "#1a1a1a" },
      "sidebarBorder": { "$value": "#c9c9c1" },
      "sidebarPrimary": { "$value": "#006b78" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#dcdcd3" },
      "sidebarAccentForeground": { "$value": "#0a0a0a" },
      "sidebarRing": { "$value": "#006b78" }
    },
    "dark": {
      "background": { "$value": "#000000", "$description": "Flat black. No gradients, no tint." },
      "foreground": { "$value": "#e6e6e1" },
      "border": { "$value": "#262626" },
      "card": { "$value": "#0a0a0a" },
      "cardForeground": { "$value": "#e6e6e1" },
      "popover": { "$value": "#0a0a0a" },
      "popoverForeground": { "$value": "#e6e6e1" },
      "primary": {
        "$value": "#00e5ff",
        "$description": "Signal cyan -- the one live wire. Links, primary actions, key numbers."
      },
      "primaryForeground": { "$value": "#000000" },
      "secondary": { "$value": "#141414" },
      "secondaryForeground": { "$value": "#e6e6e1" },
      "muted": { "$value": "#111111" },
      "mutedForeground": { "$value": "#8a8a85" },
      "accent": { "$value": "#ff2e88", "$description": "Glitch magenta -- used sparingly for interference, markers, and highlights." },
      "accentForeground": { "$value": "#000000" },
      "destructive": { "$value": "#ff3b3b" },
      "destructiveForeground": { "$value": "#000000" },
      "input": { "$value": "#333333" },
      "ring": { "$value": "#00e5ff" },
      "chart1": { "$value": "#00e5ff" },
      "chart2": { "$value": "#ff2e88" },
      "chart3": { "$value": "#f5ff3b" },
      "chart4": { "$value": "#9d7bff" },
      "chart5": { "$value": "#39ff88" },
      "sidebar": { "$value": "#050505" },
      "sidebarForeground": { "$value": "#e6e6e1" },
      "sidebarBorder": { "$value": "#1f1f1f" },
      "sidebarPrimary": { "$value": "#00e5ff" },
      "sidebarPrimaryForeground": { "$value": "#000000" },
      "sidebarAccent": { "$value": "#141414" },
      "sidebarAccentForeground": { "$value": "#e6e6e1" },
      "sidebarRing": { "$value": "#00e5ff" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Chakra Petch", "sans-serif"],
        "$description": "UI, headings, and body. Squared, machined letterforms."
      },
      "serif": { "$value": ["IBM Plex Serif", "serif"] },
      "mono": { "$value": ["JetBrains Mono", "monospace"], "$description": "Readouts, labels, dates, metadata." }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0rem",
      "$description": "Sharp corners everywhere."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
